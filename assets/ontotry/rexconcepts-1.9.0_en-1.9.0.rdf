   <rdf:Description rdf:about="https://www.gesis.org/vocabulary/rexconcepts/1.9.0/de#40">
      <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
      <skos:inScheme rdf:resource="https://www.gesis.org/vocabulary/rexconcepts/1.9.0/de"/>
      <skos:notation>40</skos:notation>
      <skos:prefLabel xml:lang="en">White supremacy</skos:prefLabel>
      <skos:definition xml:lang="en">WS describes beliefs and ideas that assert a natural superiority of the lighter-skinned or &quot;white&quot; human races over people of colour. In contemporary usage, the term White Supremacist is used to describe some groups that hold ultra-nationalist, racist or fascist doctrines. White supremacist groups have often relied on violence to achieve their goals.</skos:definition>
   </rdf:Description>
