   <rdf:Description rdf:about="https://www.gesis.org/vocabulary/rexconcepts/1.9.0/de#33">
      <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
      <skos:inScheme rdf:resource="https://www.gesis.org/vocabulary/rexconcepts/1.9.0/de"/>
      <skos:notation>33</skos:notation>
      <skos:prefLabel xml:lang="en">Anti-racism</skos:prefLabel>
      <skos:definition xml:lang="en">Anti-racism includes all approaches that aim to eliminate conditions and attitudes that are based on racist intentions.</skos:definition>
   </rdf:Description>
   <rdf:Description rdf:about="https://www.gesis.org/vocabulary/rexconcepts/1.9.0/de#32">
      <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
      <skos:inScheme rdf:resource="https://www.gesis.org/vocabulary/rexconcepts/1.9.0/de"/>
      <skos:notation>32</skos:notation>
      <skos:prefLabel xml:lang="en">Anomia</skos:prefLabel>
      <skos:definition xml:lang="en">Anomie refers to the literal opposition or absence of law and order and was introduced by Emile Durkheim (1858-1917) to analyse social distress, particularly deviant behaviours, as a result of societal modernisation (Oberwittler, 2018). In sociology, the term is often used to describe a state of lack of social norms and order at the macro level. At the individual level, the equivalent (&apos;anomia&apos;) refers to insufficient social integration and the feelings of alienation, powerlessness, helplessness and isolation that arise from it.</skos:definition>
   </rdf:Description>
   <rdf:Description rdf:about="https://www.gesis.org/vocabulary/rexconcepts/1.9.0/de#01">
      <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
      <skos:inScheme rdf:resource="https://www.gesis.org/vocabulary/rexconcepts/1.9.0/de"/>
      <skos:notation>01</skos:notation>
      <skos:prefLabel xml:lang="en">Antifeminism</skos:prefLabel>
      <skos:definition xml:lang="en">Antifeminism forms the opposition to feminism and emerged parallel to the women&apos;s movement. These are organised, heterogeneous groups of actors who explicitly position themselves against feminism and/or heteronormatively oppose the pluralisation of sexual, gender and family life forms and an accompanying recognition of these in their diversity in debates on family, gender and sexuality-related issues.</skos:definition>
   </rdf:Description>
   <rdf:Description rdf:about="https://www.gesis.org/vocabulary/rexconcepts/1.9.0/de#02">
      <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
      <skos:inScheme rdf:resource="https://www.gesis.org/vocabulary/rexconcepts/1.9.0/de"/>
      <skos:notation>02</skos:notation>
      <skos:prefLabel xml:lang="en">Antisemitism</skos:prefLabel>
      <skos:definition xml:lang="en">Anti-Semitism is a permanent, latent stock of hostile beliefs towards Jews as a collective. These beliefs manifest themselves on an individual level in the form of prejudices and stereotypes, within the culture in the form of myths, ideology, popular beliefs and symbols, as well as in the form of individual or collective actions. Social or legal discrimination, political mobilisation against Jews and collective or state violence, aim to defame, expel or oppress Jews as such.</skos:definition>
      <skos:narrower rdf:resource="https://www.gesis.org/vocabulary/rexconcepts/1.9.0/de#02.2d"/>
      <skos:narrower rdf:resource="https://www.gesis.org/vocabulary/rexconcepts/1.9.0/de#02.2a"/>
      <skos:narrower rdf:resource="https://www.gesis.org/vocabulary/rexconcepts/1.9.0/de#02.2b"/>
      <skos:narrower rdf:resource="https://www.gesis.org/vocabulary/rexconcepts/1.9.0/de#02.2c"/>
      <skos:narrower rdf:resource="https://www.gesis.org/vocabulary/rexconcepts/1.9.0/de#02.02d"/>
   </rdf:Description>
   <rdf:Description rdf:about="https://www.gesis.org/vocabulary/rexconcepts/1.9.0/de#02.2d">
      <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
      <skos:inScheme rdf:resource="https://www.gesis.org/vocabulary/rexconcepts/1.9.0/de"/>
      <skos:notation>02.2d</skos:notation>
      <skos:prefLabel xml:lang="en">NS-comparative Criticism of Israel</skos:prefLabel>
      <skos:definition xml:lang="en">Nazi-comparative critique of Israel describes the rejection of Jews that is legitimised by Israeli policies and a critique of Israel that works with Nazi comparisons and associations, e.g. by using the word &quot;war of extermination&quot; (Zick &amp; K&#xfc;pper, 2005).</skos:definition>
   </rdf:Description>
   <rdf:Description rdf:about="https://www.gesis.org/vocabulary/rexconcepts/1.9.0/de#02.2a">
      <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
      <skos:inScheme rdf:resource="https://www.gesis.org/vocabulary/rexconcepts/1.9.0/de"/>
      <skos:notation>02.2a</skos:notation>
      <skos:prefLabel xml:lang="en">Classical antisemitism</skos:prefLabel>
      <skos:definition xml:lang="en">An offensive devaluation of Jews on the basis of negative and traditional stereotypes. Examples of this are the enemy image of the Christ-killer or the money-grubbing usurious Jew.</skos:definition>
   </rdf:Description>
   <rdf:Description rdf:about="https://www.gesis.org/vocabulary/rexconcepts/1.9.0/de#02.2b">
      <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
      <skos:inScheme rdf:resource="https://www.gesis.org/vocabulary/rexconcepts/1.9.0/de"/>
      <skos:notation>02.2b</skos:notation>
      <skos:prefLabel xml:lang="en">Secondary antisemitism</skos:prefLabel>
      <skos:definition xml:lang="en">A form of Antisemitism that is specific to Germany, characterised by the relativisation, trivialisation and partial denial of the National Socialist atrocities against the European Jews. Examples include the denial of the Holocaust (Auschwitz lie) and the frequent perpetrator-victim reversal.</skos:definition>
   </rdf:Description>
   <rdf:Description rdf:about="https://www.gesis.org/vocabulary/rexconcepts/1.9.0/de#02.2c">
      <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
      <skos:inScheme rdf:resource="https://www.gesis.org/vocabulary/rexconcepts/1.9.0/de"/>
      <skos:notation>02.2c</skos:notation>
      <skos:prefLabel xml:lang="en">Israel-related antisemitism</skos:prefLabel>
      <skos:definition xml:lang="en">Holding Jews responsible for and criticising Israel&apos;s policies. The respective resident, local Jewish population outside Israel becomes a representative of Israeli politics and, because of this, a target of public attacks and discrimination.</skos:definition>
   </rdf:Description>
   <rdf:Description rdf:about="https://www.gesis.org/vocabulary/rexconcepts/1.9.0/de#02.02d">
      <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
      <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
      <skos:inScheme rdf:resource="https://www.gesis.org/vocabulary/rexconcepts/1.9.0/de"/>
      <skos:notation>02.02d</skos:notation>
      <skos:prefLabel xml:lang="en">Muslim antisemitism</skos:prefLabel>
      <skos:definition xml:lang="en"></skos:definition>
   </rdf:Description>
   <rdf:Description rdf:about="https://www.gesis.org/vocabulary/rexconcepts/1.9.0/de#03">
      <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
      <skos:inScheme rdf:resource="https://www.gesis.org/vocabulary/rexconcepts/1.9.0/de"/>
      <skos:notation>03</skos:notation>
      <skos:prefLabel xml:lang="en">Antiziganism</skos:prefLabel>
      <skos:definition xml:lang="en">Antigypsyism is a form of racism in which racist prejudices are specifically directed against a certain ethnic group. An essential component of the term is the word &apos;Gypsy&apos;, which is a discriminatory foreign designation and is often perceived as offensive by the targeted groups. Most of the people referred to by this term feel that they belong to the Sinti or Roma group. But also other groups, such as the Irish Travelers, the Dutch Woonwagenbewoers or the Yenish are stigmatised as &quot;Gypsies&quot;. Since antiziganism is fed by culturally transmitted images and stereotypes, A. often has nothing in common with the real people who are affected. In that sense, the prejudice structure takes on a life of its own.</skos:definition>
   </rdf:Description>
   <rdf:Description rdf:about="https://www.gesis.org/vocabulary/rexconcepts/1.9.0/de#04">
      <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
      <skos:inScheme rdf:resource="https://www.gesis.org/vocabulary/rexconcepts/1.9.0/de"/>
      <skos:notation>04</skos:notation>
      <skos:prefLabel xml:lang="en">Authoritarianism</skos:prefLabel>
      <skos:definition xml:lang="en">At the macro level, the term authoritarianism describes a dictatorial form of rule which, unlike dictatorial totalitarianism, often allows for a certain degree of pluralism. The most important characteristic of authoritarian forms of rule is the lack of fundamental ideologies; instead, they fall back on supposedly eternal, general values and traditional patterns of morality. In contrast to totalitarianism, authoritarianism does not focus on ideology, but on the authoritarian leader (Linz 2011). Typical of authoritarianism is the desire for power and strength, whereas weaker minorities are often despised in an aggressive manner. These minorities are also often used as scapegoats. The resulting image of the enemy is usually embodied by migrants, asylum seekers and fellow citizens of Jewish or Islamic faith.</skos:definition>
      <skos:narrower rdf:resource="https://www.gesis.org/vocabulary/rexconcepts/1.9.0/de#04.4a"/>
   </rdf:Description>
   <rdf:Description rdf:about="https://www.gesis.org/vocabulary/rexconcepts/1.9.0/de#04.4a">
      <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
      <skos:inScheme rdf:resource="https://www.gesis.org/vocabulary/rexconcepts/1.9.0/de"/>
      <skos:notation>04.4a</skos:notation>
      <skos:prefLabel xml:lang="en">Authoritarian personality</skos:prefLabel>
      <skos:definition xml:lang="en">To further define the authoritarian personality, Adorno identified nine essential character dimensions that form the basic content for qualitative and empirical analyses (especially the Fascism Scale): - Conventionalism: rigid attachment to the conventional values of the middle class. - Authoritarian submissiveness: Uncritical submission to idealised authorities of the self-group. - Authoritarian aggression: Tendency to look for people who disregard conventional values in order to condemn, reject and punish them. - Authoritarian aggression: Tendency to look for people who disregard conventional values in order to be able to condemn, reject and punish them. - Anti-intraception: rejection of the subjective, the imaginative, the sensitive. - Superstition and stereotypy: belief in the mystical determination of one&apos;s own destiny; the disposition to think in rigid categories. - Power thinking and &quot;showmanship&quot;: thinking in dimensions such as domination - submission, strong - weak, leader - followers; identification with power figures; overemphasis on conventionalised attributes of the self; exaggerated display of strength and robustness. - Destructiveness and cynicism: General hostility, defamation of the human. - Projectivity: Disposition to believe in wild and dangerous processes in the world; the projection of unconscious drive impulses onto the outside world. - Sexuality: Exaggerated preoccupation with sexual &quot;processes&quot;.</skos:definition>
   </rdf:Description>
   <rdf:Description rdf:about="https://www.gesis.org/vocabulary/rexconcepts/1.9.0/de#05">
      <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
      <skos:inScheme rdf:resource="https://www.gesis.org/vocabulary/rexconcepts/1.9.0/de"/>
      <skos:notation>05</skos:notation>
      <skos:prefLabel xml:lang="en">Chauvinism</skos:prefLabel>
      <skos:definition xml:lang="en">Chauvinism refers to the exaggerated feeling of superiority of a group, which is accompanied by contempt for people outside this group. Often chauvinism is expressed as an extreme form of patriotism or nationalism (national chauvinism). Social chauvinism as a component of the social movement describes a chauvinism of the elite against social achievements and embodies a kind of &quot;classism&quot;. Male/masculine chauvinism describes an attitude that is directed against equal rights for women in the public as well as in the private sphere.</skos:definition>
   </rdf:Description>
   <rdf:Description rdf:about="https://www.gesis.org/vocabulary/rexconcepts/1.9.0/de#39">
      <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
      <skos:inScheme rdf:resource="https://www.gesis.org/vocabulary/rexconcepts/1.9.0/de"/>
      <skos:notation>39</skos:notation>
      <skos:prefLabel xml:lang="en">Critical Whiteness</skos:prefLabel>
      <skos:definition xml:lang="en">Critical whiteness refers to the process of becoming aware of one&apos;s privileges based on a predominant skin colour or ethnicity and understanding the impact of these privileges.</skos:definition>
   </rdf:Description>
   <rdf:Description rdf:about="https://www.gesis.org/vocabulary/rexconcepts/1.9.0/de#56">
      <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
      <skos:inScheme rdf:resource="https://www.gesis.org/vocabulary/rexconcepts/1.9.0/de"/>
      <skos:notation>56</skos:notation>
      <skos:prefLabel xml:lang="en">Understanding of democracy</skos:prefLabel>
      <skos:definition xml:lang="en"></skos:definition>
   </rdf:Description>
   <rdf:Description rdf:about="https://www.gesis.org/vocabulary/rexconcepts/1.9.0/de#06">
      <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
      <skos:inScheme rdf:resource="https://www.gesis.org/vocabulary/rexconcepts/1.9.0/de"/>
      <skos:notation>06</skos:notation>
      <skos:prefLabel xml:lang="en">Discrimination</skos:prefLabel>
      <skos:definition xml:lang="en">Discrimination is considered to be a social phenomenon based on the social construction of categorisations into belonging and non-belonging and associated positions in the social structure. Discriminatory attitudes and actions (micro-level) are thus the result of discriminatory conditions that are anchored in social structures and processes (macro-level). According to the General Equal Treatment Act (AGG), discrimination is either direct  or indirect. The former occurs when a person experiences, has experienced or would experience less favourable treatment than a comparator. The latter refers to seemingly neutral regulations that put people at a disadvantage because of a characteristic that sets them apart from the majority society. Such characteristics include, for example, a person&apos;s ethnic or religious affiliation, national origin, language deficits or external characteristic features. In addition, the concept of discrimination combines an active role (discriminatory attitudes and behaviour) and a passive role (experiences or perceptions of discrimination).</skos:definition>
      <skos:narrower rdf:resource="https://www.gesis.org/vocabulary/rexconcepts/1.9.0/de#06.6a"/>
      <skos:narrower rdf:resource="https://www.gesis.org/vocabulary/rexconcepts/1.9.0/de#06.6b"/>
