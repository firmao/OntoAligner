   <rdf:Description rdf:about="https://www.gesis.org/vocabulary/rexconcepts/1.9.0/de">
      <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
      <dcterms:isVersionOf rdf:resource="null/1.0.0/1.1.0/1.2.0/1.3.0/1.4.0/1.5.0/1.6.0/1.7.0/1.8.0/1.9.0"/>
      <skos:notation>rexconcepts</skos:notation>
      <dcterms:title xml:lang="en"> Central concepts of R|EX research </dcterms:title>
      <dcterms:description xml:lang="en">This CV, developed within the framework of the DP-R|EX joint project, involving the partner institutions DeZIM, Qualiservice and GESIS, maps the central concepts and theoretical approaches in research on racism and right-wing extremism. The compilation is based on a systematic evaluation of the relevant national and international empirical research literature. The CV equally takes into account the different thematic (racism, right-wing extremism, discrimination) as well as methodological (qualitative research, standardised surveys, data from social media and messaging services) research strands. </dcterms:description>
      <owl:versionInfo>1.9.0</owl:versionInfo>
      <dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
      <dcterms:rights>Copyright &#xa9;GESIS 2025</dcterms:rights>
